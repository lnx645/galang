// Bahasa — a tour of the GaLang syntax that works today.
// Run: gar run examples/bahasa.ga

use "strings"
use "math"

print "== Variables and types =="
$nama = "GaLang"          // type is inferred
$versi = 0.1
$aktif = true
$kosong = null
$angka = 1_000_000
$heksa = 0xFF

int $stok = 72              // typed declaration
float $harga = 99.5
?string $keterangan = null  // may be null
array $tagar = []
object $meta = {}

print "$nama v${versi} — active: $aktif, stock: $stok, price: $harga"
print "tags length: ${len($tagar)}, meta keys: ${len($meta)}"

print ""
print "== Functions =="
fn greet($nama, $sapaan = "Hello") {
    return "${sapaan}, ${nama}!"
}

fn tambah(int $a, int $b) int {
    return $a + $b
}

fn kali($x) => $x * 2      // arrow function

print greet("GaLang")
print greet("GaLang", "Good morning")
print tambah(2, 3)
print kali(21)

// Closure: a function that remembers its environment.
fn penghitung() {
    $total = 0
    return fn($n) {
        $total = $total + $n
        return $total
    }
}
$hitung = penghitung()
$hitung(5)
print "counter: ${hitung(3)}"

print ""
print "== Flow control =="
$umur = 21
if $umur >= 18 {
    print "adult"
} else if $umur >= 10 {
    print "teen"
} else {
    print "child"
}

$i = 0
$jumlah = 0
while $i < 10 {
    $i = $i + 1
    if $i % 2 == 0 { continue }
    if $i > 7 { break }
    $jumlah = $jumlah + $i
}
print "sum of odd numbers 1..9: ${jumlah}"

for $n in [10, 20, 30] { print "value: ${n}" }
for $x in 1..3 { print "range: ${x}" }
for $x in 0..10..5 { print "step: ${x}" }

print ""
print "== Arrays and objects =="
$buah = ["mango", "apple", "orange"]
print "fruits: ${buah}"
print "first: ${first($buah)}, last: ${last($buah)}, count: ${len($buah)}"
print "slice: ${$buah[1:]}"
print "negative: ${$buah[-1]}"

$user = {nama: "Siti", umur: 25, tag: ["web", "backend"]}
print "user: ${$user}"
print "name: ${$user.nama}, tag[0]: ${$user.tag[0]}"

for $k, $v in {satu: 1, dua: 2} {
    print "${k} = ${v}"
}

print ""
print "== List comprehension =="
$angka = [1, 2, 3, 4, 5, 6]
print "times 2:    ${[$n * 2 for $n in $angka]}"
print "evens only: ${[$n for $n in $angka if $n % 2 == 0]}"

print ""
print "== Built-in functions =="
print "len:      ${len($buah)}"
print "sort:     ${sort($angka)}"
print "join:     ${join($angka, " | ")}"
print "map:      ${map($angka, fn($x) => $x * 10)}"
print "filter:   ${filter($angka, fn($x) => $x > 4)}"
print "reduce:   ${reduce($angka, fn($a, $b) => $a + $b, 0)}"
print "sum:      ${sum($angka)}"
print "min/max:  ${min($angka)} / ${max($angka)}"
print "in:       ${4 in $angka}"
print "keys:     ${keys($user)}"
print "merge:    ${merge({a: 1}, {b: 2})}"
print "strings:  ${strings.upper("galang")}"
print "math:     floor=${math.floor(3.7)} round=${math.round(2.5)} pi=${math.pi}"
print "json:     ${json_encode($user)}"
print "html:     ${html_escape("<b>safe</b> & <i>code</i>")}"

print ""
print "== Error handling =="
fn bagi($a, $b) {
    if $b == 0 {
        throw bad_request("division by zero is not allowed")
    }
    return $a / $b
}

try {
    print bagi(10, 2)
    print bagi(10, 0)
} catch e {
    print "caught [${e.status}]: ${e.message}"
}

$payload = json_decode(`{"ok":true,"data":[1,2,3]}`)
print "json parse: ok=${$payload.ok}, data[1]=${$payload.data[1]}"

print ""
print "== Done =="
