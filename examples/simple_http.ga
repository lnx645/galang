// Simple HTTP example for Garurda v0.2
// Jalankan: gar run examples/simple_http.ga

use "http"

http.GET("/", fn($req) {
    return "Hello from Garurda HTTP!"
})

http.GET("/about", fn($req) {
    return "About page - Garurda v0.2"
})

http.GET("/users/{id}", fn($req) {
    return "User ID: " + $req.params.id
})

http.listen(8869)
