// Simple HTTP example for GaLang v0.2
// Run: gar run examples/simple_http.ga

use "http"

http.GET("/", fn($req) {
    return "Hello from GaLang HTTP!"
})

http.GET("/about", fn($req) {
    return "About page - GaLang v0.2"
})

http.GET("/users/{id}", fn($req) {
    return "User ID: " + $req.params.id
})

http.listen(8869)
