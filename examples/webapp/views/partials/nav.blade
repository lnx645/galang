{{-- Navigasi responsif: checkbox + label sebagai toggle tanpa library. --}}
<header class="topbar">
    <div class="wrap nav">
        <a class="brand" href="/">galang<span class="accent">.</span></a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden>
        <label for="nav-toggle" class="burger" aria-label="Buka menu">&#9776;</label>
        <nav class="menu" id="menu">
            <a href="/">Beranda</a>
            <a href="/fitur">Fitur</a>
            <a href="/halo/Dunia">Template</a>
            <a href="/api/daftar">API</a>
            <a class="ghost" href="https://github.com/lnx645/galang">GitHub</a>
        </nav>
    </div>
</header>
