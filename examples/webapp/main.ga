// Web application example for Garurda v0.2 with HTTP, templates, static files
// Jalankan: gar run examples/webapp/main.ga
// Buka: http://localhost:8872

use "http"
use "strings"
use "time"

http.views("examples/webapp/views")
http.static("/public/", "examples/webapp/public")

http.GET("/", fn($req) {
    $data = {title: "Garurda v0.2", message: "Hello from Garurda!"}
    return http.render("welcome.blade", $data)
})

http.GET("/health", fn($req) {
    $now = time.now()
    return {status: 200, type: "application/json", body: "{\"status\":\"ok\",\"now\":\"" + $now + "\"}"}
})

http.GET("/greet/{name}", fn($req) {
    $name = strings.upper($req.params.name)
    return "Hello, " + $name + "!"
})

http.stream("/events", fn($req) {
    return "event: ping\ndata: {}"
})

http.listen(8872)
