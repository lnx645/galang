// Contoh aplikasi web publik Garurda — demo di port 5800.
//
// Menunjukkan: routing + path parameter, middleware http.use, sesi
// http.session (cookie HttpOnly), database SQLite nyata (query/exec),
// Blade template (@extends, @section, @yield, @include, @foreach, @if),
// file statis CSS/JS, respons JSON otomatis, structured response, dan
// error berstatus.
//
// Jalankan dari direktori ini:
//     cd examples/webapp && gar run main.ga
use "http"
use "strings"
use "time"
use "database"
use "file"

// Koneksi SQLite + bootstrap idempoten: schema.sql memakai
// CREATE TABLE IF NOT EXISTS + INSERT OR IGNORE, jadi aman dijalankan
// setiap start. File demo.db dibuat otomatis (lihat .gitignore).
$db = database.connect("sqlite:demo.db")
$db.exec(file.read("schema.sql"))

http.views("views")
http.static("/public/", "public")

// Middleware global: berjalan untuk semua rute HTTP sebelum handler.
// Kode sebelum $next = sebelum; nilai kembali dari $next = respons handler.
// Hasilnya dicatat ke stdout → jurnal systemd (journalctl -u garurda-demo).
http.use(fn($req, $next) {
    print($req.method + " " + $req.path)
    return $next($req)
})

// Data kartu beranda — diiterasi lewat @foreach di template.
$kartu = [
    {judul: "Blade", teks: "Layout @extends, slot @yield + @yield(\"b\", \"default\"), partial @include."},
    {judul: "JSON otomatis", teks: "Object/array yang di-return langsung menjadi respons application/json."},
    {judul: "CSS + JS statis", teks: "http.static menyajikan public/ — halaman ini tanpa CDN."},
    {judul: "Error berstatus", teks: "throw not_found(...) → 404 dengan body {code, message, status}."}
]

// Data fitur bahasa untuk halaman /fitur.
$fitur = [
    {kode: "async", nama: "async / await / gather", kategori: "runtime", populer: true},
    {kode: "spawn", nama: "spawn (fire-and-forget)", kategori: "runtime", populer: false},
    {kode: "promise", nama: "promise + then/catch", kategori: "runtime", populer: true},
    {kode: "type", nama: "Type hints: ?int, number, bool", kategori: "bahasa", populer: true},
    {kode: "opt", nama: `Default parameter: $x = 1`, kategori: "bahasa", populer: false},
    {kode: "ops", nama: "and / or / not + && / || / !", kategori: "bahasa", populer: true},
    {kode: "match", nama: "switch / case / default", kategori: "bahasa", populer: false},
    {kode: "try", nama: "try / catch + throw error", kategori: "bahasa", populer: true},
    {kode: "slice", nama: "Slice [a:b] + method chaining", kategori: "data", populer: false},
    {kode: "destr", nama: `Destructuring: $a, $b = ...`, kategori: "data", populer: false}
]

http.GET("/", fn($req) {
    // Backtick = string raw tanpa interpolasi — aman untuk kode bercontoh $var.
    $kodeContoh = `http.GET("/api/sapa/{nama}", fn($req) {
    return {sapaan: "Halo, " + $req.params.nama}
})

http.listen(5800)   // object → JSON otomatis`
    return http.render("home.blade", {
        judul: "Garurda — contoh web publik",
        kartu: $kartu,
        contoh: $kodeContoh
    })
})

http.GET("/fitur", fn($req) {
    return http.render("fitur.blade", {
        judul: "Fitur bahasa Garurda",
        fitur: $fitur,
        total: len($fitur)
    })
})

// Template sederhana tanpa layout — sapaan personal.
http.GET("/halo/{nama}", fn($req) {
    $nama = strings.trim($req.params.nama)
    return http.render("welcome.blade", {
        title: "Halo, " + $nama,
        message: "Dirender langsung dari http.render tanpa layout."
    })
})

// ── API JSON ────────────────────────────────────────────────────────────
http.GET("/api/sapa/{nama}", fn($req) {
    $nama = strings.trim($req.params.nama)
    if $nama == "" {
        throw bad_request("nama tidak boleh kosong")
    }
    return {
        sapaan: "Halo, " + strings.upper($nama) + "!",
        panjang: len($nama),
        waktu_ms: time.now_ms()
    }
})

http.POST("/api/echo", fn($req) {
    $data = json_decode($req.body)
    if $data == null {
        throw bad_request("body harus berupa JSON yang valid")
    }
    return {diterima: $data, metode: $req.method, panjang_body: len($req.body)}
})

// Ambil dari SQLite: baris → objek; tak ada di database → 404.
http.GET("/api/user/{id}", fn($req) {
    $row = $db.query_first("SELECT id, name, email FROM users WHERE id = ?", [$req.params.id])
    if $row == null {
        throw not_found("user dengan id " + $req.params.id + " tidak ada")
    }
    return $row
})

// Respons array → JSON array otomatis.
http.GET("/api/daftar", fn($req) {
    return $fitur
})

// Sesi HTTP: hitungan kunjungan per sesi. Server mengirim cookie
// HttpOnly (garurda_session) pada kunjungan pertama yang menulis sesi;
// penyimpanan in-memory — reset saat service restart. Tambahkan ?reset=1
// untuk menghancurkan sesi (cookie kedaluwarsa).
http.GET("/api/kunjungan", fn($req) {
    if $req.query.reset != null {
        http.session_destroy($req)
        return {kunjungan: 0, sesi_dihancurkan: true}
    }
    $s = http.session($req)
    $n = 1
    if $s.kunjungan != null {
        $n = $s.kunjungan + 1
    }
    $s.kunjungan = $n
    return {kunjungan: $n, sesi_baru: $req.session_id == null}
})

http.listen(5800)
