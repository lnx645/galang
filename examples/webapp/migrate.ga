// Migrasi database contoh — jalankan dari direktori ini:
//     gar run migrate.ga
//
// Membaca schema.sql (idempoten: CREATE TABLE IF NOT EXISTS +
// INSERT OR IGNORE) lalu mencetak jumlah baris sebagai bukti.
// main.ga juga melakukan bootstrap yang sama saat start, jadi script
// ini opsional — berguna untuk melihat langkah migrasi terpisah.
use "database"
use "file"

print("Membaca schema.sql ...")
$sql = file.read("schema.sql")

$db = database.connect("sqlite:demo.db")
print("Menjalankan migrasi ...")
$db.exec($sql)

$users = $db.query_row("SELECT count(*) AS n FROM users")
$posts = $db.query_row("SELECT count(*) AS n FROM posts")
print("Migrasi selesai. users=" + str($users.n) + ", posts=" + str($posts.n))
$db.close()
