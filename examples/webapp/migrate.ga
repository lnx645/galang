// Sample database migration — run from this directory:
//     gar run migrate.ga
//
// Reads schema.sql (idempotent: CREATE TABLE IF NOT EXISTS +
// INSERT OR IGNORE) then prints the row counts as proof.
// main.ga does the same bootstrap at startup, so this script is
// optional — useful for watching the migration steps separately.
use "database"
use "file"

print("Reading schema.sql ...")
$sql = file.read("schema.sql")

$db = database.connect("sqlite:demo.db")
print("Running migration ...")
$db.exec($sql)

$users = $db.query_row("SELECT count(*) AS n FROM users")
$posts = $db.query_row("SELECT count(*) AS n FROM posts")
print("Migration done. users=" + str($users.n) + ", posts=" + str($posts.n))
$db.close()
