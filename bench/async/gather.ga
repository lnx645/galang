// gather.ga — mengukur biaya menyelesaikan 10 promise per batch dengan
// gather. Padanan persis dari bench/js/gather.mjs (Promise.all).
async fn f($n) {
	return $n + 1
}
$s = 0
for $b in 0..999 {
	$r = gather(f(1), f(2), f(3), f(4), f(5), f(6), f(7), f(8), f(9), f(10))
	$s = $s + $r[0] + $r[9]
}
print $s
